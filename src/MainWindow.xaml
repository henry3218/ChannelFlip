<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Ui.左右聲道互換 · Channel Flip}" Width="680" Height="760" MinWidth="600" MinHeight="640" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="{DynamicResource Font14}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Page" Color="#101719"/><SolidColorBrush x:Key="Card" Color="#1A2729"/>
  <SolidColorBrush x:Key="Control" Color="#243438"/><SolidColorBrush x:Key="Text" Color="#EFF7F4"/>
  <SolidColorBrush x:Key="Muted" Color="#B3C5BF"/><SolidColorBrush x:Key="Line" Color="#536F68"/>
  <SolidColorBrush x:Key="Accent" Color="#B5EAD4"/><SolidColorBrush x:Key="AccentText" Color="#123528"/>
  <SolidColorBrush x:Key="Warning" Color="#FFD0AC"/><SolidColorBrush x:Key="Focus" Color="#F1FFF9"/><SolidColorBrush x:Key="Disabled" Color="#91A49F"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ControlButton" TargetType="ButtonBase">
   <Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="{DynamicResource Font14}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter x:Name="LabelContent" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LabelContent" Property="TextElement.Foreground" Value="{DynamicResource Disabled}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Control}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ControlButton}">
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToggleButton" BasedOn="{StaticResource ControlButton}">
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SwapToggle" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="MinWidth" Value="110"/><Setter Property="Padding" Value="7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="SwitchFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="{DynamicResource Control}" BorderBrush="{DynamicResource Text}" BorderThickness="1">
       <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource Text}"/>
      </Border>
      <ContentPresenter x:Name="SwitchLabel" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentText}"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchFocus" Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Thumb" Property="Width" Value="19"/></Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter TargetName="Track" Property="Background" Value="{DynamicResource Control}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Disabled}"/>
      <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Disabled}"/><Setter TargetName="SwitchLabel" Property="TextElement.Foreground" Value="{DynamicResource Disabled}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,9"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Control}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="Bold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Control}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" HorizontalContentAlignment="Stretch" Padding="10,7"
       IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
       Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
       <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
     </ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
      <Border Background="{DynamicResource Control}" BorderBrush="{DynamicResource Focus}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
       <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="DropDownToggle" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Disabled}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel x:Name="MainPanel" Margin="24,20,24,18">
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource Ui.左右聲道互換}" FontSize="{DynamicResource Font25}" FontWeight="Bold"/><TextBlock Text="CHANNEL FLIP" FontFamily="Segoe UI" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Width="160" VerticalAlignment="Center">
     <ComboBox x:Name="LanguageChoice" MinHeight="34" FontSize="{DynamicResource Font13}" AutomationProperties.Name="Language / 語言" ToolTip="Language / 語言"><ComboBoxItem Content="繁體中文"/><ComboBoxItem Content="English"/></ComboBox>
     <Button x:Name="Help" Content="{DynamicResource Ui.使用說明}" Padding="11,6" Margin="0,5,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
   </Grid>
   <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{DynamicResource Ui.輸出裝置}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <ComboBox x:Name="SelectionMode" Grid.Column="1" MinHeight="34" MinWidth="190" MaxWidth="320" FontSize="{DynamicResource Font13}" AutomationProperties.Name="{DynamicResource Ui.裝置選取方式}"><ComboBoxItem Content="{DynamicResource Ui.固定裝置}"/><ComboBoxItem Content="{DynamicResource Ui.跟隨系統預設}"/></ComboBox>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="Devices" AutomationProperties.Name="{DynamicResource Ui.要操作的音訊輸出裝置}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button x:Name="Refresh" Grid.Column="1" Content="{DynamicResource Ui.重新整理}" Margin="8,0,0,0" Padding="10,7"/>
   </Grid>
   <TextBlock x:Name="DeviceDetail" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,6,0,12"/>
   <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,13">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Ui.左右互換}" FontWeight="SemiBold"/><TextBlock x:Name="SettingValue" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
      <Button x:Name="SetupButton" Grid.Column="1" Content="{DynamicResource Ui.設定此裝置}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
      <ToggleButton x:Name="SwapSwitch" Grid.Column="1" Style="{StaticResource SwapToggle}" AutomationProperties.Name="{DynamicResource Ui.左右互換}"/>
     </Grid>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,11,0,0"><StackPanel>
      <TextBlock x:Name="RuntimeTitle" FontSize="{DynamicResource Font17}" FontWeight="SemiBold"/>
      <TextBlock x:Name="RuntimeDetail" FontSize="{DynamicResource Font14}" Margin="0,5,0,0" Foreground="{DynamicResource Muted}"/>
     </StackPanel></Border>
     <Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{DynamicResource Ui.預期方向}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="LeftMapping" FontSize="{DynamicResource Font16}" Margin="0,3,0,0"/></StackPanel>
      <TextBlock x:Name="RightMapping" Grid.Column="1" FontSize="{DynamicResource Font16}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="TestLeft" Content="{DynamicResource Ui.測試來源左聲道}"/><Button x:Name="TestRight" Grid.Column="2" Content="{DynamicResource Ui.測試來源右聲道}"/>
     </Grid>
     <TextBlock x:Name="TestEvidence" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
     <Button x:Name="ConfirmHearing" Content="{DynamicResource Ui.我聽到的左右方向符合}" FontSize="{DynamicResource Font13}" Margin="0,8,0,0" Padding="10,6" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="Message" FontSize="{DynamicResource Font14}" Margin="0,9,0,0"/>
   <Expander x:Name="ErrorExpander" Header="{DynamicResource Ui.錯誤詳情}" FontSize="{DynamicResource Font14}" Margin="0,8,0,0" Foreground="{DynamicResource Warning}">
    <StackPanel><TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" Padding="8" Margin="0,7,0,0"/>
     <Button x:Name="CopyError" Content="{DynamicResource Ui.複製錯誤詳情}" HorizontalAlignment="Left" Margin="0,7,0,0"/>
    </StackPanel>
   </Expander>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="SoundSettings" Content="{DynamicResource Ui.Windows 音效}" HorizontalAlignment="Left" Padding="11,7"/><Button x:Name="Advanced" Grid.Column="1" Content="{DynamicResource Ui.進階設定}" HorizontalAlignment="Right" Padding="11,7"/>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</Window>
